#!/bin/sh
# tas-sd mount|umount|dev
sddev() {
    for d in /dev/mmcblk1p1 /dev/mmcblk1; do
        [ -b $d ] && { echo $d; return 0; }
    done
    return 1
}
case "$1" in
mount)
    grep -q ' /mnt/sd ' /proc/mounts && exit 0
    i=0
    while [ $i -lt 25 ]; do
        D=$(sddev)
        if [ -n "$D" ]; then
            mount -t vfat -o rw,noatime,utf8 $D /mnt/sd 2>/dev/null && exit 0
            mount -t ext4 -o noatime $D /mnt/sd 2>/dev/null && exit 0
        fi
        mdev -s
        sleep 0.2
        i=$((i+1))
    done
    exit 1
    ;;
umount)
    sync
    umount /mnt/sd 2>/dev/null
    ! grep -q ' /mnt/sd ' /proc/mounts
    ;;
dev)
    sddev
    ;;
*)
    echo "usage: tas-sd mount|umount|dev"
    exit 1
    ;;
esac
